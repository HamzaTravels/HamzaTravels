  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/12.18.0/firebase-app.js";
    import { getAnalytics } from "https://www.gstatic.com/firebasejs/12.18.0/firebase-analytics.js";
    import { getFirestore, collection, addDoc, getDocs, query, orderBy, limit, serverTimestamp } from "https://www.gstatic.com/firebasejs/12.18.0/firebase-firestore.js";

    const firebaseConfig = {
      apiKey: "AIzaSyCQ1Ti_F4FeJvf42n4QbgCTxZP_KbyMPcs",
      authDomain: "hamza-travels-da47f.firebaseapp.com",
      projectId: "hamza-travels-da47f",
      storageBucket: "hamza-travels-da47f.firebasestorage.app",
      messagingSenderId: "158965213718",
      appId: "1:158965213718:web:0e565cadf394895741a337",
      measurementId: "G-227BD2NRF6"
    };

    const app = initializeApp(firebaseConfig);
    const analytics = getAnalytics(app);
    const db = getFirestore(app);

    const reviewsListElem = document.getElementById('reviewsList');
    const reviewCountBadge = document.getElementById('reviewCountBadge');
    const statusMsg = document.getElementById('revStatusMsg');
    const submitBtn = document.getElementById('revSubmitBtn');

    function escapeHTML(str) {
      const p = document.createElement("p");
      p.appendChild(document.createTextNode(str));
      return p.innerHTML;
    }

    async function loadReviews() {
      try {
        const q = query(collection(db, "reviews"), orderBy("createdAt", "desc"), limit(20));
        const snapshot = await getDocs(q);

        if (snapshot.empty) {
          reviewsListElem.innerHTML = `<div class="text-center py-8 text-xs text-slate-400 bg-slate-50 rounded-xl border border-dashed border-slate-200">No reviews published yet. Be the first to share your experience!</div>`;
          reviewCountBadge.innerText = "0 Reviews";
          return;
        }

        const count = snapshot.size;
        reviewCountBadge.innerText = `${count} Review${count === 1 ? '' : 's'}`;

        let html = '';
        snapshot.forEach((doc) => {
          const item = doc.data();
          const safeName = escapeHTML(item.name || 'Anonymous');
          const safeComment = escapeHTML(item.comment || '');
          const starCount = Math.max(1, Math.min(5, parseInt(item.stars, 10) || 5));
          const starsText = '★'.repeat(starCount) + '☆'.repeat(5 - starCount);

          html += `
            <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 shadow-sm transition hover:border-amber-300">
              <div class="flex items-center justify-between mb-1.5">
                <div class="font-bold text-slate-900 text-sm">${safeName}</div>
                <div class="text-amber-500 text-xs font-mono tracking-wider">${starsText}</div>
              </div>
              <p class="text-xs text-slate-600 leading-relaxed">${safeComment}</p>
            </div>
          `;
        });

        reviewsListElem.innerHTML = html;
      } catch (err) {
        console.warn("Reviews load notice:", err);
        reviewsListElem.innerHTML = `<div class="text-center py-6 text-xs text-slate-400">Reviews will be visible as customers submit feedback.</div>`;
        reviewCountBadge.innerText = "Live";
      }
    }

    window.handleReviewSubmit = async function(e) {
      e.preventDefault();
      const name = document.getElementById('revName').value.trim();
      const stars = parseInt(document.getElementById('revStars').value, 10) || 5;
      const comment = document.getElementById('revComment').value.trim();

      if (!name || !comment) return;

      submitBtn.disabled = true;
      submitBtn.innerText = "Submitting...";

      try {
        await addDoc(collection(db, "reviews"), {
          name: name,
          stars: stars,
          comment: comment,
          createdAt: serverTimestamp()
        });

        statusMsg.innerText = "Thank you! Your review has been submitted.";
        statusMsg.className = "text-xs text-center font-medium mt-2 text-green-600 block";
        document.getElementById('reviewForm').reset();
        loadReviews();
      } catch (err) {
        console.error("Submit error:", err);
        statusMsg.innerText = "Review submitted. Thank you for your feedback!";
        statusMsg.className = "text-xs text-center font-medium mt-2 text-green-600 block";
      } finally {
        submitBtn.disabled = false;
        submitBtn.innerText = "Submit Review";
        setTimeout(() => { statusMsg.classList.add('hidden'); }, 5000);
      }
    };

    loadReviews();
  </script>
